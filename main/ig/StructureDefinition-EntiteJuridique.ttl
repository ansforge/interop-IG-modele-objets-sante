         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://mos.esante.gouv.fr/NOS/TRE_R72-FinessStatutJuridique/FHIR/TRE-R72-FinessStatutJuridique?vs" ;
           fhir:link <https://mos.esante.gouv.fr/NOS/TRE_R72-FinessStatutJuridique/FHIR/TRE-R72-FinessStatutJuridique?vs>
         ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "EntiteJuridique.agregatStatutJuridiqueNiv1" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteJuridique.agregatStatutJuridiqueNiv1" ] ;
       fhir:ElementDefinition.short [ fhir:value "Agrégat de statut juridique de niveau 1. L'agrégat de niveau 1 représente des regroupements d'agrégats de niveau 2. Par exemple, le code 1000 \"Organismes et Etablissements publics\" regroupe les codes d'agrégat de niveau 2 1100 et 1200." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Agrégat de statut juridique de niveau 1. L'agrégat de niveau 1 représente des regroupements d'agrégats de niveau 2. Par exemple, le code 1000 \"Organismes et Etablissements publics\" regroupe les codes d'agrégat de niveau 2 1100 et 1200." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [

       fhir:ElementDefinition.path [ fhir:value "EntiteJuridique.typeIdNatStruct" ] ;
       fhir:ElementDefinition.short [ fhir:value "Type d’identifiant national de la structure." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Type d’identifiant national de la structure." ] ;

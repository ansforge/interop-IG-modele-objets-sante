         fhir:ElementDefinition.type.code [ fhir:value "Coding" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "preferred" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://mos.esante.gouv.fr/NOS/TRE_R69-FinessAgregatStatutJuridiqueNiv2/FHIR/TRE-R69-FinessAgregatStatutJuridiqueNiv2?vs" ;
           fhir:link <https://mos.esante.gouv.fr/NOS/TRE_R69-FinessAgregatStatutJuridiqueNiv2/FHIR/TRE-R69-FinessAgregatStatutJuridiqueNiv2?vs>
         ]
       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "EntiteJuridique.agregatStatutJuridiqueNiv3" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteJuridique.agregatStatutJuridiqueNiv3" ] ;
       fhir:ElementDefinition.short [ fhir:value "Agrégat de statut juridique de niveau 3. L'agrégat de niveau 3 représente des regroupements de statuts juridiques. Par exemple, le code 1120 \"Collectivité territoriale\" regroupe les statuts juridiques 02, 03 etc." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Agrégat de statut juridique de niveau 3. L'agrégat de niveau 3 représente des regroupements de statuts juridiques. Par exemple, le code 1120 \"Collectivité territoriale\" regroupe les statuts juridiques 02, 03 etc." ] ;

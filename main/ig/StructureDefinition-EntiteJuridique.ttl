       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "EntiteJuridique.complementRaisonSociale" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteJuridique.complementRaisonSociale" ] ;
       fhir:ElementDefinition.short [ fhir:value "Suite de la raison sociale, si elle existe. Ce complément peut contenir notamment des informations facilitant l'adressage d'un courrier aux structures." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Suite de la raison sociale, si elle existe. Ce complément peut contenir notamment des informations facilitant l'adressage d'un courrier aux structures." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;

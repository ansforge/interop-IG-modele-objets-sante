       fhir:ElementDefinition.short [ fhir:value "Raison sociale complète de l'entité juridique (acronymes, sigles ou abréviations développées)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Raison sociale complète de l'entité juridique (acronymes, sigles ou abréviations développées)." ] ;

       fhir:ElementDefinition.path [ fhir:value "PersonnePriseCharge.INS.lieuNaissance" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code officiel géographique (COG) de la commune (France) ou du pays. C'est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Code officiel géographique (COG) de la commune (France) ou du pays. C'est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP." ] ;

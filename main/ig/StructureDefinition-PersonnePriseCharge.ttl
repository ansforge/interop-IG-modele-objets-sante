       fhir:Element.id [ fhir:value "PersonnePriseCharge.INS.nomNaissance" ] ;
       fhir:ElementDefinition.path [ fhir:value "PersonnePriseCharge.INS.nomNaissance" ] ;
       fhir:ElementDefinition.short [ fhir:value "Le nom de  naissance est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP.C'est  un trait \"strict\" d'identité de la personne dans l'INS ( Référentiel Identité Nationale de Santé)synonyme moins précis : nom de famille" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Le nom de  naissance est un élément d’identité mentionné à l’article R. 1111-8-6 du CSP.C'est  un trait \"strict\" d'identité de la personne dans l'INS ( Référentiel Identité Nationale de Santé)synonyme moins précis : nom de famille" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;

  fhir:StructureDefinition.date [ fhir:value "2026-06-26T11:59:32+00:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.publisher [ fhir:value "Agence du Numérique en Santé (ANS) - 2-10 Rue d'Oradour-sur-Glane, 75015 Paris"] ;
  fhir:StructureDefinition.contact [
     fhir:index 0 ;
     fhir:ContactDetail.name [ fhir:value "Agence du Numérique en Santé (ANS) - 2-10 Rue d'Oradour-sur-Glane, 75015 Paris" ] ;
     fhir:ContactDetail.telecom [
       fhir:index 0 ;

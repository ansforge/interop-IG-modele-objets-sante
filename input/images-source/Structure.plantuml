@startuml
!theme carbon-gray

Class "[[StructureDefinition-EntiteGeographiqueExercice.html EntiteGeographiqueExercice]]" as EntiteGeographiqueExercice {
  accessibiliteLieu : Coding [0..1]
  agregatCategorieEGENiv1 : Coding [0..1]
  agregatCategorieEGENiv2 : Coding [0..1]
  agregatCategorieEGENiv3 : Coding [0..1]
  aideFinanciere : Coding [0..*]
  categorieEGE : Coding [0..1]
  champActivite : Coding [0..*]
  commentaire : string [0..1]
  complementNom : string [0..1]
  dateAutorisation : date [0..1]
  dateFermeture : date [0..1]
  dateOuverture : date [0..1]
  domaine : Coding [0..*]
  identifiantEG : Identifier [0..1]
  idNatStruct : Identifier [0..1]
  indicateurHabilitationSoinSansConsentement : boolean [0..1]
  indicateurHebergementFamille : boolean [0..1]
  indicateurZonePoser : boolean [0..1]
  modaliteParticipationSPH : Coding [0..1]
  modeFixationTarif : Coding [0..1]
  nbPlaceAideSocialePermanent : integer [0..1]
  nbPlaceAideSocialeTemporaire : integer [0..1]
  niveauRecoursORSAN : Coding [0..1]
  nomCourt : string [0..1]
  nomLong : string [0..1]
  nomOperationnel : string [0..1]
  numeroEducationNationale : Identifier [0..1]
  numeroReferenceExterne : Identifier [0..1]
  numFINESS : Identifier [0..1]
  secteurActivite : Coding [0..1]
  typeBudget : Coding [0..1]
  typeFermeture : Coding [0..1]
  typeIdNatStruct : Coding [0..1]
}

Class "[[StructureDefinition-EntiteGroupementStructure.html EntiteGroupementStructure]]" as EntiteGroupementStructure {
  role : Coding [0..*]
}

Class "[[StructureDefinition-EtablissementINSEE.html EtablissementINSEE]]" as EtablissementINSEE {
  codeActivitePrincipaleEtablissement : Coding [0..1]
  dateCreationEtablissement : date [0..1]
  denominationUsuelleEtablissement : string [0..1]
  enseigneEtablissement : string [0..*]
  siret : Identifier [0..1]
}

Class "[[StructureDefinition-GroupeCooperationConventionnelle.html GroupeCooperationConventionnelle]]" as GroupeCooperationConventionnelle {
  autoriteRegulation : Coding [0..1]
  nomGroupeGCC : string [0..1]
  typeGroupeGCC : Coding [0..1]
}

Class "[[StructureDefinition-PersonneMorale.html PersonneMorale]]" as PersonneMorale {
  agregatStatutJuridiqueFinessNiv1 : Coding [0..1]
  agregatStatutJuridiqueFinessNiv2 : Coding [0..1]
  agregatStatutJuridiqueFinessNiv3 : Coding [0..1]
  complementNom : string [0..1]
  dateEntreeFiness : date [0..1]
  dateSortieFiness : date [0..1]
  fonctionPublique : Coding [0..1]
  identifiantEJ : Identifier [0..1]
  idNatStruct : Identifier [0..1]
  nomCourt : string [0..1]
  nomLong : string [0..1]
  numeroSRN : Identifier [0..*]
  numeroTVAIntracommunautaire : Identifier [0..1]
  numFINESS : Identifier [0..1]
  statutJuridiqueFiness : Coding [0..1]
  typeFermeture : Coding [0..1]
  typeIdNatStruct : Coding [0..1]
  typePersonneMorale : Coding [0..1]
}

Class "[[StructureDefinition-RelationEGE.html RelationEGE]]" as RelationEGE {
  role : Coding [0..1]
}

Class "[[StructureDefinition-UniteLegaleINSEE.html UniteLegaleINSEE]]" as UniteLegaleINSEE {
  activitePrincipaleUniteLegale : Coding [0..1]
  categorieJuridiqueINSEE : Coding [0..1]
  dateINSEECessationEntreprise : date [0..1]
  dateINSEECreationEntreprise : date [0..1]
  denominationINSEE : string [0..1]
  siren : Identifier [0..1]
}

package "Professionnel" as Professionnel_part {
  Class "[[StructureDefinition-SituationExercice.html SituationExercice]]" as SituationExercice
}

package "Dispositif d'authentification" as Dispositif_d'authentification_part {
  Class "[[StructureDefinition-Certificat.html Certificat]]" as Certificat
}

package "Autorisation" as Autorisation_part {
  Class "[[StructureDefinition-EquipementMaterielLourd.html EquipementMaterielLourd]]" as EquipementMaterielLourd
  Class "[[StructureDefinition-ActiviteAutoriseeExercee.html ActiviteAutoriseeExercee]]" as ActiviteAutoriseeExercee
}

package "Accord" as Accord_part {
  Class "[[StructureDefinition-LicenceExploitation.html LicenceExploitation]]" as LicenceExploitation
  Class "[[StructureDefinition-Engagement.html Engagement]]" as Engagement
}

package "Offre opérationnelle" as Offre_opérationnelle_part {
  Class "[[StructureDefinition-OffreOperationnelle.html OffreOperationnelle]]" as OffreOperationnelle
}

package "Organisation opérationnelle" as Organisation_opérationnelle_part {
  Class "[[StructureDefinition-OrganisationInterne.html OrganisationInterne]]" as OrganisationInterne
}

package "Personne prise en charge" as Personne_prise_en_charge_part {
  Class "[[StructureDefinition-Emploi.html Emploi]]" as Emploi
}

package "Accompagnant" as Accompagnant_part {
  Class "[[StructureDefinition-AidantDemarche.html AidantDemarche]]" as AidantDemarche
  Class "[[StructureDefinition-MesureProtection.html MesureProtection]]" as MesureProtection
}

package "Dossier" as Dossier_part {
  Class "[[StructureDefinition-NoteLiaison.html NoteLiaison]]" as NoteLiaison
}

package "Agenda" as Agenda_part {
  Class "[[StructureDefinition-Agenda.html Agenda]]" as Agenda
  Class "[[StructureDefinition-RendezVous.html RendezVous]]" as RendezVous
}

package "Dispositif médical" as Dispositif_médical_part {
  Class "[[StructureDefinition-DispositifMedical.html DispositifMedical]]" as DispositifMedical
}

EntiteGeographiqueExercice "1..*" -- "1" PersonneMorale
EntiteGeographiqueExercice "0..1" -- "*" EntiteGroupementStructure
EntiteGeographiqueExercice "*" -- "0..1" EtablissementINSEE
EntiteGeographiqueExercice "1" -- "*" RelationEGE
EntiteGroupementStructure "*" -- "0..1" PersonneMorale
GroupeCooperationConventionnelle "*" -- "1" PersonneMorale
PersonneMorale "1" -- "0..1" UniteLegaleINSEE
EntiteGeographiqueExercice "0..1" -- "*" SituationExercice
EntiteGeographiqueExercice "0..1" -- "*" Certificat
PersonneMorale "0..1" -- "0..1" Certificat
EntiteGeographiqueExercice "1" -- "*" EquipementMaterielLourd
EntiteGeographiqueExercice "0..1" -- "*" ActiviteAutoriseeExercee
GroupeCooperationConventionnelle "*" -- "*" ActiviteAutoriseeExercee
PersonneMorale "1" -- "*" ActiviteAutoriseeExercee
EntiteGeographiqueExercice "1" -- "0..1" LicenceExploitation
EntiteGeographiqueExercice "0..1" -- "*" Engagement
PersonneMorale "0..1" -- "*" Engagement
EntiteGeographiqueExercice "0..1" -- "*" OffreOperationnelle
EntiteGeographiqueExercice "1..*" -- "*" OrganisationInterne
EntiteGeographiqueExercice "1" -- "0..1" Emploi
EntiteGeographiqueExercice "0..1" -- "0..1" AidantDemarche
EntiteGeographiqueExercice "0..1" -- "0..1" MesureProtection
EntiteGeographiqueExercice "0..1" -- "*" NoteLiaison
EntiteGeographiqueExercice "*" -- "*" Agenda
EntiteGeographiqueExercice "*" -- "*" RendezVous
PersonneMorale "1" -- "*" DispositifMedical

@enduml
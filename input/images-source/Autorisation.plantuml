@startuml
!theme carbon-gray

Class "[[StructureDefinition-ActiviteAutoriseeExercee.html ActiviteAutoriseeExercee]]" as ActiviteAutoriseeExercee {
  dateDebutPeriode : date [0..1]
  dateDecision : dateTime [0..1]
  dateFin : date [0..1]
  dateFinPeriode : date [0..1]
  datePremiereMiseEnOeuvre : date [0..1]
  dureeAutorisation : Quantity [0..1]
  indicateurSuppressionAutorisation : boolean [0..1]
  indicateurSuppressionImplantation : boolean [0..1]
  natureActivite : Coding [0..1]
  numeroAutorisationARHGOS : Identifier [0..1]
  typeActiviteSMSSE : Coding [0..1]
}

Class "[[StructureDefinition-CapaciteActiviteAutoriseeExercee.html CapaciteActiviteAutoriseeExercee]]" as CapaciteActiviteAutoriseeExercee {
  genreConcerne : Coding [0..1]
  habilitation : Coding [0..1]
  modeFinancement : Coding [0..1]
  typeLogement : Coding [0..1]
}

package "Structure" as Structure_part {
  Class "[[StructureDefinition-EntiteGeographiqueExercice.html EntiteGeographiqueExercice]]" as EntiteGeographiqueExercice
  Class "[[StructureDefinition-GroupeCooperationConventionnelle.html GroupeCooperationConventionnelle]]" as GroupeCooperationConventionnelle
  Class "[[StructureDefinition-PersonneMorale.html PersonneMorale]]" as PersonneMorale
}

package "Accord" as Accord_part {
  Class "[[StructureDefinition-Engagement.html Engagement]]" as Engagement
}

ActiviteAutoriseeExercee "*" -- "0..1" EntiteGeographiqueExercice
ActiviteAutoriseeExercee "*" -- "*" GroupeCooperationConventionnelle
ActiviteAutoriseeExercee "*" -- "1" PersonneMorale
ActiviteAutoriseeExercee "*" -- "1..*" Engagement
ActiviteAutoriseeExercee "1" -- "*" CapaciteActiviteAutoriseeExercee

@enduml
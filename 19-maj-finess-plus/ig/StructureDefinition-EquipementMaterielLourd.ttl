  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : DéfinitionStructure EquipementMaterielLourd</b></p><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"xhtTableBorder0\"><tr class=\"xhtRowBorder1\"><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Le nom logique de l'élément\">Nom</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Informations sur l'utilisation de l'élément\">Drapeaux</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Nombre minimum et maximum de fois que l'élément peut apparaître dans l'instance\">Card.</a></th><th scope=\"col\" style=\"; width: 100px\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Référence au type de l'élément\">Type</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Informations supplémentaires sur l'élément\">Description et contraintes</a><span style=\"float: right\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Legend for this format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/></a></span></th></tr><tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck1.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_element.gif\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Element\" class=\"hierarchy\"/> <a href=\"StructureDefinition-EquipementMaterielLourd-definitions.html#EquipementMaterielLourd\" title=\"Les Equipements Matériels Lourds (EML) sont des équipements déployés en établissement pour le diagnostic ou la thérapeutique.Il s'agit d'équipements onéreux, essentiellement de type scanner ou IRM.La liste des types d'équipements concernés figure à l'article R6122-2 du CSP.La mise en œuvre d'un EML est soumise à l'autorisation du DG ARS.Les données FINESS concernant les EML sont issues en totalité du SI Autorisations\">EquipementMaterielLourd</a><a name=\"EquipementMaterielLourd\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\"><span class=\"xhtPieceDeEmphasized\">0</span><span class=\"xhtPieceDeEmphasized\">..</span><span class=\"xhtPieceDeEmphasized\">*</span></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\">ActiviteAutoriseeExercee</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Les Equipements Matériels Lourds (EML) sont des équipements déployés en établissement pour le diagnostic ou la thérapeutique.Il s'agit d'équipements onéreux, essentiellement de type scanner ou IRM.La liste des types d'équipements concernés figure à l'article R6122-2 du CSP.La mise en œuvre d'un EML est soumise à l'autorisation du DG ARS.Les données FINESS concernant les EML sont issues en totalité du SI Autorisations<br/><br/>Éléments définis dans les ancêtres :<a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date début effective de l'autorisation\">dateDebutPeriode</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de décision du Directeur Général de l’ARS (date de l’arrête d’autorisation). Il s’agit donc de la date de délivrance de l’autorisation de l’activité autorisée exercée.Synonyme FINESS : date d’autorisationRemarque : Cette donnée est calculée à partir des événements FINESS\">dateDecision</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de fin effective de l'autoriation de cette activité. Elle peut arriver avant la date prévisionnelle si l'ARS retire l'autorisation par exemple où si la structure arrête son activité et renonce à son autorisation. C'est cette date qui indique si l'activité est &quot;vivante&quot; ou non. Si elle est vide, l'activité est toujours autorisée.Synonyme  : Date d'échéance de l'autorisation.\">dateFin</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de fin prévisionnelle de l'autorisation NB : Une autorisation d'activité réglementée est donnée pour une durée finie (exemple 15 ans pour le médico-social). On enregistre donc la date prévue ou l'autorisation sera échue et où la structure devra obtenir une nouvelle autorisation (ie un renouvellement) pour poursuivre son activité.\">dateFinPeriode</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de mise en œuvre. Elle doit être postérieure à la date de l’arrêté d'autorisation. La mise en oeuvre est déclenchée à la réception par l’ARS du courrier du directeur de l’établissement.Synonyme FINESS : date de mise en œuvre\">datePremiereMiseEnOeuvre</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Durée de l'autorisation.\">dureeAutorisation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Evénement(s) administratif(s) survenu(s) dans l'activité\">evenementAdministratif</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Indicateur de suppression de l'autorisation de l'activité Autorisée exercée\">indicateurSuppressionAutorisation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Indicateur de suppression de l’implantation de l'activité autorisée exercée.Donnée propre à FINESS calculée à partir des evenements\">indicateurSuppressionImplantation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Le Code de la nature de l'activité régulée permet de déterminer la Nature de l'activité parmi les natures actuellement identifiées\">natureActivite</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Identifiant fonctionnel de l'autorisation ARHGOS de l'EML.\">numeroAutorisationARHGOS</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Typologie des Activités Sanitaires, Médico-Sociales, Sociales et d'Enseignement, définie comme le champ des possibles pour définir l'Activité associée à une structure SMSSE.Classe associative matérialisant l'association Activité SMSSE RéguléeAncien  synonyme :  mode de fonctionnement\">typeActiviteSMSSE</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Zone d'intervention de l'Activité Autorisée. Correspond au territoire sur lequel s'exerce un service, une activité.\">zoneInterventionAutorisee</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe EntiteGeographiqueExercice\">EntiteGeographiqueExercice</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe GroupeCooperationConventionnelle\">GroupeCooperationConventionnelle</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe PersonneMorale\">PersonneMorale</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe Engagement\">Engagement</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe CapaciteActiviteAutoriseeExercee\">CapaciteActiviteAutoriseeExercee</a></td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowOdd\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_element.gif\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Element\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">EquipementMaterielLourd.</span><a href=\"StructureDefinition-EquipementMaterielLourd-definitions.html#EquipementMaterielLourd.EntiteGeographiqueExercice\">EntiteGeographiqueExercice</a><a name=\"EquipementMaterielLourd.EntiteGeographiqueExercice\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">1..<span class=\"xhtPieceDeEmphasized\">1</span></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-EntiteGeographiqueExercice.html\" class=\"xhtPieceDeEmphasized\">EntiteGeographiqueExercice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><span class=\"xhtPieceDeEmphasized\">Lien vers la classe EntiteGeographiqueExercice</span></td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_datatype.gif\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Type de donnée\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">EquipementMaterielLourd.</span><a href=\"StructureDefinition-EquipementMaterielLourd-definitions.html#EquipementMaterielLourd.activite\" title=\"Code définissant l'équipement matériel lourd (EML) soumis à autorisation.\">activite</a><a name=\"EquipementMaterielLourd.activite\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\">Coding</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Code définissant l'équipement matériel lourd (EML) soumis à autorisation.<br class=\"binding\"/><span class=\"xhtPieceBold binding\">Binding: </span><a href=\"https://smt.esante.gouv.fr/fhir/ValueSet/vs-tre-r272-equipement-materiel-lourd-all\" title=\"https://mos.esante.gouv.fr/NOS/TRE_R272-EquipementMaterielLourd/FHIR/TRE-R272-EquipementMaterielLourd?vs\" class=\"binding\">Vs Tre R272 Equipement Materiel Lourd All <img src=\"external.png\" alt=\"\"/></a><span class=\"binding\"> (</span><a href=\"http://hl7.org/fhir/R4/terminologies.html#preferred\" title=\"Instances are encouraged to draw from the specified codes for interoperability purposes but are not required to do so to be considered conformant.\" class=\"binding\">preferred</a><span class=\"binding\">)</span></td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowOdd\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_primitive.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Type de donnée primitif\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">EquipementMaterielLourd.</span><a href=\"StructureDefinition-EquipementMaterielLourd-definitions.html#EquipementMaterielLourd.marque\" title=\"Marque de l'équipement matériel lourd (EML).\">marque</a><a name=\"EquipementMaterielLourd.marque\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\">string</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Marque de l'équipement matériel lourd (EML).</td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck00.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin_end.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_primitive.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Type de donnée primitif\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">EquipementMaterielLourd.</span><a href=\"StructureDefinition-EquipementMaterielLourd-definitions.html#EquipementMaterielLourd.numeroSerie\" title=\"Numéro de série de l'équipement matériel lourd (EML).\">numeroSerie</a><a name=\"EquipementMaterielLourd.numeroSerie\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\">string</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Numéro de série de l'équipement matériel lourd (EML).</td></tr>#xD;\n<tr><td colspan=\"5\" class=\"hierarchy\"><br/><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Légende pour ce format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/> Documentation pour ce format</a></td></tr></table></div>"

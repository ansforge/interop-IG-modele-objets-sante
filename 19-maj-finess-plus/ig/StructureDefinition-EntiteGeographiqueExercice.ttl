       ]
     ], [
       fhir:index 36 ;
       fhir:Element.id [ fhir:value "EntiteGeographiqueExercice.numeroReferenceExterne" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteGeographiqueExercice.numeroReferenceExterne" ] ;
       fhir:ElementDefinition.short [ fhir:value "Référence externe  de l' EGE.  Par exemple numéro de licence des pharmacie : FINESS n'enregistre pas d'activité des pharmacies. Cette information est la seule information relative à l'activité avec la catégorie." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Référence externe  de l' EGE.  Par exemple numéro de licence des pharmacie : FINESS n'enregistre pas d'activité des pharmacies. Cette information est la seule information relative à l'activité avec la catégorie." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;

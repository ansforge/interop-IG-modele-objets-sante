           fhir:link <https://smt.esante.gouv.fr/fhir/CodeSystem/tre-r397-categorie-entite-geographique-exercice?vs>
         ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "EntiteGeographiqueExercice.agregatCategorieEGENiv2" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteGeographiqueExercice.agregatCategorieEGENiv2" ] ;
       fhir:ElementDefinition.short [ fhir:value "Agrégat de catégorie d'Entité Géographique d'Exercice (EGE) de niveau 2. L'agrégat de niveau 2 représente des regroupements d'agrégats de niveau 3. Par exemple, le code 1100 \"Etablissement hospitaliers\" regroupe les codes d'agrégat de niveau 3 1101, 1102, etc." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Agrégat de catégorie d'Entité Géographique d'Exercice (EGE) de niveau 2. L'agrégat de niveau 2 représente des regroupements d'agrégats de niveau 3. Par exemple, le code 1100 \"Etablissement hospitaliers\" regroupe les codes d'agrégat de niveau 3 1101, 1102, etc." ] ;

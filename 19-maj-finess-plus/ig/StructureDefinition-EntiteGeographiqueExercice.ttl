       fhir:Element.id [ fhir:value "EntiteGeographiqueExercice.aideFinanciere" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteGeographiqueExercice.aideFinanciere" ] ;
       fhir:ElementDefinition.short [ fhir:value "Habilitation ou conventionnement de l'entité géographique permettant aux personnes accueillies de bénéficier des aides financières, si elles remplissent les conditions.Remarque : Cette donnée n'est pas FINESS" ] ;

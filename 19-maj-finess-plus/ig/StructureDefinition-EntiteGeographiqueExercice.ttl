       fhir:index 2 ;
       fhir:Element.id [ fhir:value "EntiteGeographiqueExercice.adresse" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteGeographiqueExercice.adresse" ] ;
       fhir:ElementDefinition.short [ fhir:value "Adresse(s) géopostale(s) de l'entité géographique en fonction de l'usage (adresse administrative, adresse entrée des véhicules, adresse entrée piétonne, etc.).L'implantation géographique peut également être décrite au travers de la classe Lieu." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Adresse(s) géopostale(s) de l'entité géographique en fonction de l'usage (adresse administrative, adresse entrée des véhicules, adresse entrée piétonne, etc.).L'implantation géographique peut également être décrite au travers de la classe Lieu." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;

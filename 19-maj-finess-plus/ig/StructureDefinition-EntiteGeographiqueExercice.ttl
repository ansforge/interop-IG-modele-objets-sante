       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "EntiteGeographiqueExercice.agregatCategorieEGENiv1" ] ;
       fhir:ElementDefinition.path [ fhir:value "EntiteGeographiqueExercice.agregatCategorieEGENiv1" ] ;
       fhir:ElementDefinition.short [ fhir:value "Agrégat de catégorie d'Entité Géographique d'Exercice (EGE) de niveau 1. L'agrégat de niveau 1 représente des regroupements d'agrégat de niveau 2. Par exemple, le code 1000 \"Etablissement relevant de la loi hospitalière\" regroupe les codes d'agrégat de niveau 2 1100 et 1200." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Agrégat de catégorie d'Entité Géographique d'Exercice (EGE) de niveau 1. L'agrégat de niveau 1 représente des regroupements d'agrégat de niveau 2. Par exemple, le code 1000 \"Etablissement relevant de la loi hospitalière\" regroupe les codes d'agrégat de niveau 2 1100 et 1200." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "EntiteGeographiqueExercice.agregatCategorieEGENiv1" ] ;

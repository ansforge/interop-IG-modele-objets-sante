       fhir:ElementDefinition.short [ fhir:value "Suite du nom de la personne morale. Ce complément peut contenir notamment des informations facilitant l'adressage d'un courrier aux structures.Ancien synonyme : complément raison sociale" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Suite du nom de la personne morale. Ce complément peut contenir notamment des informations facilitant l'adressage d'un courrier aux structures.Ancien synonyme : complément raison sociale" ] ;

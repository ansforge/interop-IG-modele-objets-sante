# - resource -------------------------------------------------------------------

<https://interop.esante.gouv.fr/ig/mos/StructureDefinition/ActiviteSOCialeRegulee> a fhir:StructureDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ActiviteSOCialeRegulee"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : DéfinitionStructure ActiviteSOCialeRegulee</b></p><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"xhtTableBorder0\"><tr class=\"xhtRowBorder1\"><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Le nom logique de l'élément\">Nom</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Informations sur l'utilisation de l'élément\">Drapeaux</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Nombre minimum et maximum de fois que l'élément peut apparaître dans l'instance\">Card.</a></th><th scope=\"col\" style=\"; width: 100px\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Référence au type de l'élément\">Type</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Informations supplémentaires sur l'élément\">Description et contraintes</a><span style=\"float: right\"><a href=\"https://build.fhir.org/ig/FHIR/ig-guidance/readingIgs.html#table-views\" title=\"Legend for this format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/></a></span></th></tr><tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck1.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_element.gif\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Element\" class=\"hierarchy\"/> <a href=\"StructureDefinition-ActiviteSOCialeRegulee-definitions.html#ActiviteSOCialeRegulee\" title=\"Les activités ASOCR sont les activités autorisées pour les ESSMS et les structures du champ social.Ces activités sont détaillées sous forme d'un triplet :- discipline- mode de fonctionnement- public pris en chargePour chaque activité, peut en outre être notée une capacité autorisée (nombre de places d'hébergement par exemple)\">ActiviteSOCialeRegulee</a><a name=\"ActiviteSOCialeRegulee\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\"><span class=\"xhtPieceDeEmphasized\">0</span><span class=\"xhtPieceDeEmphasized\">..</span><span class=\"xhtPieceDeEmphasized\">*</span></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\">ActiviteAutoriseeExercee</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Les activités ASOCR sont les activités autorisées pour les ESSMS et les structures du champ social.Ces activités sont détaillées sous forme d'un triplet :- discipline- mode de fonctionnement- public pris en chargePour chaque activité, peut en outre être notée une capacité autorisée (nombre de places d'hébergement par exemple)<br/><br/>Éléments définis dans les ancêtres :<a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date début effective de l'autorisation\">dateDebutPeriode</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de décision du Directeur Général de l’ARS (date de l’arrête d’autorisation). Il s’agit donc de la date de délivrance de l’autorisation de l’activité autorisée exercée.Synonyme FINESS : date d’autorisationRemarque : Cette donnée est calculée à partir des événements FINESS\">dateDecision</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de fin effective de l'autoriation de cette activité. Elle peut arriver avant la date prévisionnelle si l'ARS retire l'autorisation par exemple où si la structure arrête son activité et renonce à son autorisation. C'est cette date qui indique si l'activité est &quot;vivante&quot; ou non. Si elle est vide, l'activité est toujours autorisée.Synonyme  : Date d'échéance de l'autorisation.\">dateFin</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de fin prévisionnelle de l'autorisation NB : Une autorisation d'activité réglementée est donnée pour une durée finie (exemple 15 ans pour le médico-social). On enregistre donc la date prévue ou l'autorisation sera échue et où la structure devra obtenir une nouvelle autorisation (ie un renouvellement) pour poursuivre son activité.\">dateFinPeriode</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Date de mise en œuvre. Elle doit être postérieure à la date de l’arrêté d'autorisation. La mise en oeuvre est déclenchée à la réception par l’ARS du courrier du directeur de l’établissement.Synonyme FINESS : date de mise en œuvre\">datePremiereMiseEnOeuvre</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Durée de l'autorisation.\">dureeAutorisation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Evénement(s) administratif(s) survenu(s) dans l'activité\">evenementAdministratif</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Indicateur de suppression de l'autorisation de l'activité Autorisée exercée\">indicateurSuppressionAutorisation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Indicateur de suppression de l’implantation de l'activité autorisée exercée.Donnée propre à FINESS calculée à partir des evenements\">indicateurSuppressionImplantation</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Le Code de la nature de l'activité régulée permet de déterminer la Nature de l'activité parmi les natures actuellement identifiées\">natureActivite</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Identifiant fonctionnel de l'autorisation ARHGOS de l'EML.\">numeroAutorisationARHGOS</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Typologie des Activités Sanitaires, Médico-Sociales, Sociales et d'Enseignement, définie comme le champ des possibles pour définir l'Activité associée à une structure SMSSE.Classe associative matérialisant l'association Activité SMSSE RéguléeAncien  synonyme :  mode de fonctionnement\">typeActiviteSMSSE</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Zone d'intervention de l'Activité Autorisée. Correspond au territoire sur lequel s'exerce un service, une activité.\">zoneInterventionAutorisee</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe EntiteGeographiqueExercice\">EntiteGeographiqueExercice</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe GroupeCooperationConventionnelle\">GroupeCooperationConventionnelle</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe PersonneMorale\">PersonneMorale</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe Engagement\">Engagement</a>, <a href=\"StructureDefinition-ActiviteAutoriseeExercee.html\" title=\"Lien vers la classe CapaciteActiviteAutoriseeExercee\">CapaciteActiviteAutoriseeExercee</a></td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowOdd\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_datatype.gif\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Type de donnée\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">ActiviteSOCialeRegulee.</span><a href=\"StructureDefinition-ActiviteSOCialeRegulee-definitions.html#ActiviteSOCialeRegulee.activite\" title=\"Code définissant l'activité &quot;ASOC&quot; des Activités SMSSE RéguléesLa liste des activités de soins soumises à autorisation est fixée par décret en Conseil d'Etat (article L.6122-25 du CSP).\">activite</a><a name=\"ActiviteSOCialeRegulee.activite\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\">Coding</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Code définissant l'activité \"ASOC\" des Activités SMSSE RéguléesLa liste des activités de soins soumises à autorisation est fixée par décret en Conseil d'Etat (article L.6122-25 du CSP).<br class=\"binding\"/><span class=\"xhtPieceBold binding\">Binding: </span><a href=\"https://smt.esante.gouv.fr/fhir/CodeSystem/tre-r401-activite-sociale-regulee?vs\" class=\"binding\">https://smt.esante.gouv.fr/fhir/CodeSystem/tre-r401-activite-sociale-regulee?vs</a><span class=\"binding\"> (</span><a href=\"http://hl7.org/fhir/R4/terminologies.html#preferred\" title=\"Instances are encouraged to draw from the specified codes for interoperability purposes but are not required to do so to be considered conformant.\" class=\"binding\">preferred</a><span class=\"binding\">)</span></td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_resource.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Ressource\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">ActiviteSOCialeRegulee.</span><a href=\"StructureDefinition-ActiviteSOCialeRegulee-definitions.html#ActiviteSOCialeRegulee.ageMaxAutorise\" title=\"Age maximum de la clientèle autorisée.\">ageMaxAutorise</a><a name=\"ActiviteSOCialeRegulee.ageMaxAutorise\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-Patientele.html\">Patientele</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Age maximum de la clientèle autorisée.</td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowOdd\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_resource.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Ressource\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">ActiviteSOCialeRegulee.</span><a href=\"StructureDefinition-ActiviteSOCialeRegulee-definitions.html#ActiviteSOCialeRegulee.ageMaxInstalle\" title=\"Age maximum de la clientèle installée.\">ageMaxInstalle</a><a name=\"ActiviteSOCialeRegulee.ageMaxInstalle\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-Patientele.html\">Patientele</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Age maximum de la clientèle installée.</td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowEven\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_resource.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"Ressource\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">ActiviteSOCialeRegulee.</span><a href=\"StructureDefinition-ActiviteSOCialeRegulee-definitions.html#ActiviteSOCialeRegulee.ageMinAutorise\" title=\"Age minimum de la clientèle autorisée.\">ageMinAutorise</a><a name=\"ActiviteSOCialeRegulee.ageMinAutorise\"> </a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\"/><td style=\"\" class=\"hierarchy xhtCellBorder0\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder0\"><a href=\"StructureDefinition-Patientele.html\">Patientele</a></td><td style=\"\" class=\"hierarchy xhtCellBorder0\">Age minimum de la clientèle autorisée.</td></tr>#xD;\n<tr class=\"xhtRowBorder0 xhtRowOdd\"><td style=\"background-image: url(tbl_bck10.png)\" class=\"hierarchy xhtCellBorder0 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_resource.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"Ressource\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-on
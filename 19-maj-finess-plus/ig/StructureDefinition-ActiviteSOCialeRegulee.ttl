         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "ActiviteSOCialeRegulee.datePremiereMiseEnOeuvre" ] ;
       fhir:ElementDefinition.path [ fhir:value "ActiviteSOCialeRegulee.datePremiereMiseEnOeuvre" ] ;
       fhir:ElementDefinition.short [ fhir:value "Date de mise en œuvre. Elle doit être postérieure à la date de l’arrêté d'autorisation. La mise en oeuvre est déclenchée à la réception par l’ARS du courrier du directeur de l’établissement.Synonyme FINESS : date de mise en œuvre" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Date de mise en œuvre. Elle doit être postérieure à la date de l’arrêté d'autorisation. La mise en oeuvre est déclenchée à la réception par l’ARS du courrier du directeur de l’établissement.Synonyme FINESS : date de mise en œuvre" ] ;

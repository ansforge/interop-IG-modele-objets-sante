         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "ActiviteSOCialeRegulee.dateFinPeriode" ] ;
       fhir:ElementDefinition.path [ fhir:value "ActiviteSOCialeRegulee.dateFinPeriode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Date de fin prévisionnelle de l'autorisation NB : Une autorisation d'activité réglementée est donnée pour une durée finie (exemple 15 ans pour le médico-social). On enregistre donc la date prévue ou l'autorisation sera échue et où la structure devra obtenir une nouvelle autorisation (ie un renouvellement) pour poursuivre son activité." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Date de fin prévisionnelle de l'autorisation NB : Une autorisation d'activité réglementée est donnée pour une durée finie (exemple 15 ans pour le médico-social). On enregistre donc la date prévue ou l'autorisation sera échue et où la structure devra obtenir une nouvelle autorisation (ie un renouvellement) pour poursuivre son activité." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;

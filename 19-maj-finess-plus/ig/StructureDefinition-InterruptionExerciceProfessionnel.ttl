       fhir:ElementDefinition.short [ fhir:value "Lien vers la classe ExerciceProfessionnel" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Lien vers la classe ExerciceProfessionnel" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;

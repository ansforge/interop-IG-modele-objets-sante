     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "InterruptionExerciceProfessionnel.perimetreInterruption" ] ;
       fhir:ElementDefinition.path [ fhir:value "InterruptionExerciceProfessionnel.perimetreInterruption" ] ;
       fhir:ElementDefinition.short [ fhir:value "Le périmètre d’une interruption d’exercice décrit l’étendue de la restriction appliquée à l’activité du professionnel. Cette information permet d’apprécier concrètement les possibilités d’exercice du professionnel et contribue à la gestion des droits associés, notamment en matière d’accès aux services numériques en santé." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Le périmètre d’une interruption d’exercice décrit l’étendue de la restriction appliquée à l’activité du professionnel. Cette information permet d’apprécier concrètement les possibilités d’exercice du professionnel et contribue à la gestion des droits associés, notamment en matière d’accès aux services numériques en santé." ] ;
